{
  "Create new stories": {
    "prefix": "create-new-stories",
    "description": "새로운 스토리북 템플릿을 생성합니다.",
    "body": [
      "import type { Meta, StoryObj } from \"@storybook/react\";",
      "import { fn } from \"@storybook/test\";",
      "import ${TM_FILENAME/(.*).stories.tsx$/$1/} from \".\";",
      "",
      "const meta = {",
      "  title: \"${1:Reusable}/${TM_FILENAME/(.*).stories.tsx$/$1/}\",",
      "  component: ${TM_FILENAME/(.*).stories.tsx$/$1/},",
      "  parameters: {",
      "    layout: \"centered\",",
      "  },",
      "  tags: [\"autodocs\"],",
      "  args: { onChange: fn() },",
      "} satisfies Meta<typeof ${TM_FILENAME/(.*).stories.tsx$/$1/}>;",
      "",
      "export default meta;",
      "type Story = StoryObj<typeof meta>;",
      "",
      "export const Default: Story = {",
      "  args: {${2}},",
      "};"
    ],
    "scope": "typescriptreact"
  },
  "Create new store": {
    "prefix": "create-new-store",
    "description": "새로운 Zustand 스토어를 생성합니다.",
    "body": [
      "import { create } from \"zustand\";",
      "",
      "type ${1:Some}Store = {",
      "  ${2}",
      "};",
      "",
      "export const use${1:Some}Store = create<${1:Some}Store>((set, get) => ({",
      "  ${3}",
      "}));",
      ""
    ],
    "scope": "typescript"
  },
  "Import Utilities": {
    "prefix": "import-utilities",
    "description": "유틸리티를 불러옵니다.",
    "body": ["import * as ${2:${1}Utils} from \"@/utils/${1}Utils\";"],
    "scope": "typescript,typescriptreact"
  },
  "Import THREE.js": {
    "prefix": "import-three",
    "description": "THREE.js를 불러옵니다.",
    "body": ["import * as ${1:THREE} from \"three\";"],
    "scope": "typescript,typescriptreact"
  }
}
